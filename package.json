{
  "name": "musicmaxxer",
  "private": true,
  "version": "1.0.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "app": "open '../MusicMaxxer/target/release/bundle/macos/MusicMaxxer.app'",
    "app:build": "tauri build --bundles app",
    "app:install": "cp -R 'target/release/bundle/macos/MusicMaxxer.app' /Applications/ && echo 'Installed to /Applications'"
  },
  "dependencies": {
    "@tauri-apps/api": "^2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
